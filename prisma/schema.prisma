datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  name          String
  phone         String?
  role          String      @default("CUSTOMER") // SUPER_ADMIN, STORE_MANAGER, INVENTORY_MANAGER, ORDER_MANAGER, LOGISTICS_MANAGER, CUSTOMER_SUPPORT, CONTENT_MANAGER, CUSTOMER
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  auditLogs     AuditLog[]
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  state         String
  city          String
  streetAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  description   String?
  imageUrl      String?
  parentId      String?
  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[]  @relation("CategoryHierarchy")
  isPopular     Boolean     @default(false)
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products      Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  sku                String               @unique
  brandId            String
  brand              Brand                @relation(fields: [brandId], references: [id])
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id])
  series             String?              // e.g. "ThinkPad", "EliteBook", "MacBook Pro", "Latitude"
  modelNumber        String?              // e.g. "T490s", "840 G8", "M3 Max"
  condition          String               @default("REFURBISHED") // BRAND_NEW, REFURBISHED, USED, OPEN_BOX
  conditionDetails   String?              // e.g. "Grade A+ Like-New, 100% GTC Certified"
  basePrice          Float                // Current selling price in NGN
  comparePrice       Float?               // Strikethrough/previous price in NGN
  discountPercent    Int?                 @default(0)
  stockQuantity      Int                  @default(0)
  availabilityStatus String               @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK, PRE_ORDER, SOURCING_AVAILABLE
  warrantyMonths     Int                  @default(6)
  warrantyDetails    String?              @default("GuaranteedTech 6-Month Warranty with free technical support")
  shortDescription   String?
  fullDescription    String?
  intendedUsage      String?              // comma-separated: "PROGRAMMING,BUSINESS,STUDENT,GRAPHIC_DESIGN"
  isFeatured         Boolean              @default(false)
  isBestSeller       Boolean              @default(false)
  isNewArrival       Boolean              @default(false)
  isSpecialOffer     Boolean              @default(false)
  viewCount          Int                  @default(0)
  salesCount         Int                  @default(0)
  isPublished        Boolean              @default(true)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  variants           ProductVariant[]
  images             ProductImage[]
  specifications     ProductSpecification[]
  reviews            Review[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  enquiries          ProductEnquiry[]
  sourceRelations    RelatedProduct[]     @relation("SourceProduct")
  targetRelations    RelatedProduct[]     @relation("TargetProduct")
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String      @unique
  name            String      // e.g. "16GB RAM / 256GB SSD / Core i7"
  ram             String?     // e.g. "16GB"
  storage         String?     // e.g. "256GB SSD"
  color           String?     // e.g. "Matte Black"
  cpu             String?     // e.g. "Intel Core i7-8665U"
  priceAdjustment Float       @default(0) // Added to product basePrice
  stockQuantity   Int         @default(0)
  isDefault       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ProductSpecification {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category     String   // e.g. "Processor", "Memory & Storage", "Display", "Connectivity", "Battery"
  specKey      String   // e.g. "Processor Speed", "RAM Slots", "Resolution"
  specValue    String   // e.g. "1.9GHz up to 4.8GHz, 4 Cores, 8 Threads"
  displayOrder Int      @default(0)
}

model RelatedProduct {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation("SourceProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product  @relation("TargetProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relationType     String   @default("ALTERNATIVE") // ALTERNATIVE, ACCESSORY, UPGRADE, FREQUENTLY_BOUGHT_TOGETHER
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewerName       String
  rating             Int      // 1 to 5 stars
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique // e.g. "GT-2026-1001"
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName         String
  customerEmail        String
  customerPhone        String
  deliveryState        String
  deliveryCity         String
  deliveryAddress      String
  deliveryInstructions String?
  channel              String               @default("WEBSITE") // WEBSITE, WHATSAPP, IN_STORE
  status               String               @default("PENDING") // PENDING, AWAITING_PAYMENT, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  paymentStatus        String               @default("UNPAID") // UNPAID, PENDING_VERIFICATION, PAID, FAILED, REFUNDED
  paymentMethod        String               @default("PAYSTACK") // PAYSTACK, FLUTTERWAVE, BANK_TRANSFER, CASH_ON_DELIVERY
  subtotal             Float
  deliveryFee          Float                @default(0)
  discountTotal        Float                @default(0)
  totalAmount          Float
  notes                String?
  internalNotes        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  items                OrderItem[]
  payment              PaymentTransaction?
  shipment             Shipment?
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantName  String?
  unitPrice    Float
  quantity     Int
  totalPrice   Float
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference       String    @unique
  gateway         String    // PAYSTACK, FLUTTERWAVE, BANK_TRANSFER, COD
  amount          Float
  currency        String    @default("NGN")
  status          String    @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  gatewayResponse String?
  proofUrl        String?   // For manual bank transfer receipt
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String    @default("GIG_LOGISTICS") // GIG_LOGISTICS, MANUAL_DISPATCH
  trackingNumber    String?
  waybillNumber     String?
  labelUrl          String?
  status            String    @default("BOOKED") // BOOKED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED, RETURNED
  statusDescription String?
  codAmount         Float?    @default(0)
  pickupStation     String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model HomepageSection {
  id           String            @id @default(uuid())
  sectionKey   String            @unique // e.g. "announcement", "hero_carousel", "featured_categories", "featured_products", "best_sellers", "new_arrivals", "special_offers", "brands", "smart_finder_promo", "accessories", "reviews", "articles", "newsletter"
  title        String
  subtitle     String?
  sectionType  String            // HERO_CAROUSEL, CATEGORY_GRID, PRODUCT_GRID, BANNER_PROMO, REVIEWS_CAROUSEL, ARTICLES_GRID, HTML_BLOCK
  displayOrder Int               @default(0)
  isPublished  Boolean           @default(true)
  configJson   String?           // JSON configuration for styling, product filters, limits
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  banners      HomepageBanner[]
}

model HomepageBanner {
  id           String          @id @default(uuid())
  sectionId    String
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title        String
  subtitle     String?
  imageUrl     String
  targetUrl    String
  buttonText   String?
  badgeText    String?
  displayOrder Int             @default(0)
  isPublished  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SearchDemandLog {
  id                    String   @id @default(uuid())
  query                 String
  normalizedQuery       String
  categoryFilter        String?
  brandFilter           String?
  minPrice              Float?
  maxPrice              Float?
  resultCount           Int
  hasExactMatch         Boolean  @default(false)
  isUnavailableProduct  Boolean  @default(false)
  requestedAlternatives String?  // JSON string of recommended alternative product IDs
  convertedToOrder      Boolean  @default(false)
  createdAt             DateTime @default(now())
}

model ProductEnquiry {
  id                String   @id @default(uuid())
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name              String
  email             String
  phone             String
  enquiryType       String   @default("AVAILABILITY") // AVAILABILITY, SPECIFICATION, BULK_PURCHASE, PRODUCT_SOURCING, SPECIAL_PRICING, TECHNICAL_SUPPORT
  requestedQuantity Int      @default(1)
  targetBudget      Float?
  message           String
  status            String   @default("PENDING") // PENDING, IN_REVIEW, CONTACTED, QUOTED, CONVERTED_TO_ORDER, CLOSED
  assignedTo        String?
  internalNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "CREATE_PRODUCT", "UPDATE_PRICE", "PUBLISH_HOMEPAGE_SECTION", "CONFIRM_PAYMENT", "DISPATCH_SHIPMENT"
  entity    String   // e.g. "Product", "Order", "HomepageSection"
  entityId  String?
  details   String?  // JSON details of changes
  ipAddress String?
  createdAt DateTime @default(now())
}

